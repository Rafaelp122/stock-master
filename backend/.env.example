# --- DJANGO CORE SETTINGS ---
DEBUG=True
SECRET_KEY=django-insecure-substituir-em-producao
# No Docker/Local use localhost,127.0.0.1,db
ALLOWED_HOSTS=localhost,127.0.0.1,db

# --- DATABASE CONFIGURATION (POSTGRES) ---
POSTGRES_DB=stockmaster_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- CORS & SECURITY ---
# Origens permitidas (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- CLOUD STORAGE (Issue #10 / Issue #5) ---
# Necessário quando formos para o Google Cloud Run
GS_BUCKET_NAME=nome-do-seu-bucket
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account.json

# --- EMAIL CONFIGURATION (Opcional) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=sua-senha-de-app