{
  // --- Interface e Geral ---
  "window.zoomLevel": 0,
  "liveServer.settings.port": 5501,

  // --- Python: Pylance e Análise Estática ---
  "python.languageServer": "Pylance",
  "python.analysis.typeCheckingMode": "basic",
  "python.defaultInterpreterPath": "${workspaceFolder}/venv/bin/python",

  // --- Testes (Pytest) ---
  "python.testing.unittestEnabled": false,
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": [
    "."
  ],

  // --- Formatação e Linting com Ruff ---
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
      "source.fixAll": "explicit"
    }
  },

  // Configurações do Ruff
  "ruff.nativeServer": true,

  // --- Configurações de JavaScript/React ---
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },

  // Configurações do ESLint
  "eslint.workingDirectories": ["./frontend"],

  // --- Configurações de HTML ---
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features",
    "editor.formatOnSave": true,
    "editor.quickSuggestions": {
      "other": true,
      "comments": true,
      "strings": true
    }
  },

  // --- Associações de Ficheiros ---
  "files.associations": {
    "*.html": "html",
    "*.xml": "html",
    "*.svg": "html",
    "*.js": "javascript",
    "*.jsx": "javascriptreact",
    "**/requirements{/**,*}.{txt,in}": "pip-requirements"
  },

  // --- Emmet (Atalhos de Código) ---
  "emmet.includeLanguages": {
    "javascript": "javascriptreact"
  },

  // Esconde pastas que raramente precisa abrir, limpando o visual do explorador
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/node_modules": true,
    "venv": true
  }
}